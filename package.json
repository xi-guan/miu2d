{
  "name": "miu2d",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "bun@1.3.14",
  "workspaces": ["packages/*"],
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "turbo run dev gen:trpc:watch --parallel --filter=@miu2d/web --filter=@miu2d/server --filter=@miu2d/types",
    "dev:web": "turbo run dev --filter=@miu2d/web",
    "dev:server": "turbo run dev gen:trpc:watch --parallel --filter=@miu2d/server --filter=@miu2d/types",
    "build": "turbo run build",
    "build:web": "bun run --filter=@miu2d/types build && bun run --filter=@miu2d/server db:generate && bun run --filter=@miu2d/server gen:trpc && bun run --filter=@miu2d/web build",
    "build:wasm": "bash scripts/build-wasm.sh",
    "lint": "biome lint packages/",
    "format": "biome format --write packages/",
    "check": "biome check --write packages/",
    "tsc": "turbo run tsc",
    "test": "turbo run test",
    "preview": "bun run --filter=@miu2d/web preview",
    "db:up": "docker-compose up -d db rustfs",
    "db:down": "docker-compose down",
    "db:migrate": "bun run --filter=@miu2d/server db:migrate",
    "db:seed": "bun run --filter=@miu2d/server db:seed"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.13",
    "turbo": "^2.8.17",
    "typescript": "~7.0.2"
  },
  "overrides": {
    "vite": "^8.0.0"
  },
  "trustedDependencies": [
    "@prisma/engines",
    "prisma",
    "sharp",
    "bcrypt"
  ]
}
