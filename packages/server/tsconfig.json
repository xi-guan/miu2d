{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "paths": {
      "@/*": ["./src/*"],
      "@miu2d/types": ["../types/src/index.ts"],
      "@miu2d/shared/locales": ["../shared/src/locales/index.ts"]
    },
    "sourceMap": true,
    "types": ["node", "bun"],
    "resolvePackageJsonExports": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "erasableSyntaxOnly": false,
    "jsx": "react-jsx"
  },
  "include": ["src"]
}
