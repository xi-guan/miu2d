{
  "name": "@miu2d/server",
  "description": "Backend API: Hono + tRPC + Prisma + S3 resource storage",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./trpc": "./src/trpc/@generated/app-router.ts"
  },
  "scripts": {
    "gen:trpc": "bun scripts/generate-trpc-types.ts",
    "gen:trpc:watch": "bun scripts/generate-trpc-types.ts --watch",
    "dev": "bun run db:generate && bun --watch src/main.ts",
    "start": "bun src/main.ts",
    "tsc": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:seed": "bun src/seed.ts",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.982.0",
    "@aws-sdk/s3-request-presigner": "^3.982.0",
    "@smithy/node-http-handler": "^4.4.9",
    "@hono/trpc-server": "^0.4.2",
    "@miu2d/shared": "workspace:*",
    "@miu2d/types": "workspace:*",
    "@prisma/adapter-pg": "^7.4.2",
    "@prisma/client": "^7.4.2",
    "@react-email/components": "^1.0.7",
    "@trpc/server": "^11.0.0",
    "dotenv": "^17.2.3",
    "hono": "^4.11.9",
    "nodemailer": "^8.0.1",
    "pg": "^8.14.0",
    "react": "^19.2.4",
    "react-email": "^5.2.8",
    "reflect-metadata": "^0.2.2",
    "sharp": "^0.34.5",
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "@types/bun": "^1.3.8",
    "@types/node": "^25.0.9",
    "@types/nodemailer": "^7.0.9",
    "@types/pg": "^8.11.14",
    "@types/react": "^19.2.10",
    "chokidar": "^5.0.0",
    "prisma": "^7.4.2",
    "ts-morph": "^27.0.2",
    "typescript": "~7.0.2"
  }
}
